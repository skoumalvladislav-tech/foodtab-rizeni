# Copy to deploy.env and fill in. deploy.env is gitignored — it holds resource
# identifiers for your Cloudflare account, not secrets.
#
# Create the resources once:
#   npx wrangler login
#   npx wrangler d1 create foodtab-rizeni      # prints database_id
#   npx wrangler r2 bucket create foodtab-rizeni

WORKER_NAME=foodtab-rizeni
D1_DATABASE_NAME=foodtab-rizeni
D1_DATABASE_ID=
R2_BUCKET_NAME=foodtab-rizeni
