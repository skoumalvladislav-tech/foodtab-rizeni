        "body": "={{ JSON.stringify({ text: \"FoodTab Marketing — ranní běh automatizací selhal (HTTP \" + $json.statusCode + \"). Dnešní návrhy nevznikly.\", statusCode: $json.statusCode }) }}"
      },
      "id": "7e55cd45-23de-4fcd-9521-de9c08002516",
