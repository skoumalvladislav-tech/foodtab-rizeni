{
  "name": "FoodTab Marketing — publikace podle plánu",
  "nodes": [
    {
      "parameters": {
        "content": "## Publikace naplánovaných příspěvků\n\nKaždých **5 minut** šťouchne do fronty aplikace\n(`POST /api/v1/ulohy/zpracovat` s hlavičkou `X-Cron-Secret`).\n\n**Publikace se neděje v n8n.** Fronta v aplikaci si sama ověří, že\nschválení pořád platí (otisk verze), a teprve pak zavolá publisher.\nn8n je jen budík — když vypadne, nic se neztratí, jen se to zveřejní\npři dalším běhu.\n\nKdyž volání selže (nebo vrátí jiný stav než 2xx), pošle se upozornění\nna `NOTIFY_WEBHOOK_URL`, pokud je nastavená.\n\nČasové pásmo bere Schedule Trigger z nastavení n8n — nastavte\n`Europe/Prague`.\n\nProměnné: `FOODTAB_MARKETING_URL`, `FOODTAB_CRON_SECRET`,\n`NOTIFY_WEBHOOK_URL`.",
        "width": 460,
        "height": 460,
        "color": 7
      },
      "id": "0ceff0f1-0fff-45f5-973a-45d0eb679189",
      "name": "Popis",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -180
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "5252925b-bd02-4b3c-97df-a8d780f1720a",
      "name": "Každých 5 minut",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -140,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FOODTAB_MARKETING_URL }}/api/v1/ulohy/zpracovat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Secret",
              "value": "={{ $env.FOODTAB_CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ duvod: \"scheduled-social-publish\" }) }}"
      },
      "id": "f47da23c-9df6-4d20-b23e-d3be533a7a6f",
      "name": "Zpracovat frontu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e6b60d02-bd50-4a05-9b7a-fe928a9210ff",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "d78ba9ad-e3b3-4590-9ed0-9146552bf0de",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 300,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "bcc1ced7-7d98-4daa-aa3d-ea65443e9898",
      "name": "Prošlo to?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "256bc93f-582f-42fa-933b-3dcc23d67315",
              "name": "publikovano",
              "value": "={{ $json.body && $json.body.publikace ? $json.body.publikace.published : 0 }}",
              "type": "number"
            },
            {
              "id": "a0462533-756d-4ad3-a2f4-dc3f9fbeda33",
              "name": "selhalo",
              "value": "={{ $json.body && $json.body.publikace ? $json.body.publikace.failed : 0 }}",
