            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Secret",
              "value": "={{ $env.FOODTAB_CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ duvod: \"render-monitor\" }) }}"
      },
      "id": "fbd3206a-9911-4f80-82cc-447b1e3c39da",
      "name": "Zpracovat frontu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        0
      ]
    },
    {
