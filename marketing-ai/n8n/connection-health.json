              "leftValue": "={{ $json.testOk }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "e03fb68d-16d1-4809-b358-8951ec0e14a0",
              "leftValue": "={{ $json.problemy.length }}",
