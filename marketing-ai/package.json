{
  "name": "foodtab-marketing-ai",
  "version": "0.1.0",
  "private": true,
  "description": "FoodTab Marketing AI – tvorba, schvalování a publikování gastro obsahu",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:db": "node --experimental-strip-types tests/db/run.ts",
    "test:e2e": "playwright test",
    "db:reset": "node --experimental-strip-types scripts/db-reset.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@electric-sql/pglite": "0.5.8",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.2.6",
    "postgres": "3.4.7",
    "qrcode-generator": "2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  }
}
