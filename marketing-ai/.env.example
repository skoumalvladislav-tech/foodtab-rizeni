# =====================================================================
# FoodTab Marketing AI — nastavení prostředí
#
# Bez jediné hodnoty níže aplikace běží v DEMO REŽIMU: databáze PGlite
# v souboru .data/pglite, přihlášení demo uživatelem, všichni externí
# poskytovatelé v režimu "mock" (viditelně označeno v rozhraní).
# Žádné tajemství sem nepatří — tenhle soubor je v gitu.
# =====================================================================

# --- Základní běh --------------------------------------------------------
# demo | production. V "production" je demo přihlášení vypnuté.
APP_MODE=demo
# Veřejná adresa téhle aplikace (OAuth callback, odkazy v notifikacích).
APP_URL=http://localhost:3000
# Tajemství pro podpis cookies, signed URL a webhooků. Vygenerujte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Klíč pro šifrování uložených credentials zákazníků (32 bajtů hex).
# Bez něj se v produkci žádná integrace nepřipojí.
CREDENTIALS_ENCRYPTION_KEY=

# --- Databáze ------------------------------------------------------------
# Prázdné = PGlite (demo). Pro Supabase použijte "Session pooler" nebo
# přímé připojení z Project Settings → Database. RLS se vynucuje tím, že
# každý dotaz běží pod rolí `authenticated` s nastaveným uživatelem.
DATABASE_URL=

# --- Supabase Auth + Storage (produkce) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servisní klíč NIKDY do prohlížeče. Používá se jen na serveru pro
# Storage (podepsané adresy) a pro ověření webhooků.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=marketing-media

# --- Propojení s FoodTab Řízení -----------------------------------------
# Odkaz "Zpět do FoodTabu" a povolené návratové adresy (ochrana před
# open redirectem). Produkční doména se do komponent nezapisuje.
FOODTAB_APP_URL=https://foodtab-rizeni.vercel.app
# Sdílené tajemství pro podpis webhooků menu.* z FoodTabu (etapa 3).
FOODTAB_WEBHOOK_SECRET=

# --- Doporučení poskytovatelé (zákazník je připojuje v aplikaci) ---------
# Tyto proměnné slouží jen jako FOODTAB-SPRAVOVANÁ výchozí hodnota pro
# vývoj. Zákaznické klíče se ukládají šifrované v databázi, ne sem.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SHOTSTACK_API_KEY=
# stage | v1
SHOTSTACK_ENV=stage
# Meta aplikace (Facebook Login for Business) — App ID a App Secret.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# n8n instance a tajemství pro podpis webhooků oběma směry.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
