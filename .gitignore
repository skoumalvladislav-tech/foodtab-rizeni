# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# cloudflare deploy config (resource ids, machine-specific)
deploy.env

# Konfigurace Claude Code. Sdílí se jen seznam povolení, aby ho měl celý
# tým stejný; launch.json a místní nastavení zůstávají u každého svoje.
.claude/*
!.claude/settings.json

# mezivýsledek inkrementální typové kontroly (tsc --noEmit)
*.tsbuildinfo
scripts/mobil/sestavene.css
scripts/mobil/hlavicka.html
