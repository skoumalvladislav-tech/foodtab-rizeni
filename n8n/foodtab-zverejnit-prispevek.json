      "id": "f63b1c66-d0c7-4abb-b335-1c0920502d4e",
      "name": "Přečíst požadavek",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Co prijde z Foodtabu. Nic se nedomysli: co chybi, je chyba.\nconst t = $input.first().json.body || {};\nconst chybi = [];\nfor (const p of ['tenant_id','branch_id','kanal','idempotencni_klic','popisek']) {\n  if (!t[p]) chybi.push(p);\n}\nconst obrazky = Array.isArray(t.obrazky) ? t.obrazky.filter((o) => o && o.url) : [];\nif (obrazky.length === 0) chybi.push('obrazky');\n\nreturn [{ json: {\n  ok: chybi.length === 0,\n  duvod: chybi.length ? ('Chybi povinne udaje: ' + chybi.join(', ')) : '',\n  tenant_id: t.tenant_id || '',\n  branch_id: t.branch_id || '',\n  kanal: t.kanal || '',\n  klic: t.idempotencni_klic || '',\n  popisek: String(t.popisek || ''),\n  obrazek: obrazky.length ? obrazky[0].url : '',\n} }];"
      }
    },
