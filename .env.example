# Adresa projektu Supabase a jeho VEŘEJNÝ (anon) klíč.
# Obojí najdete v Supabase → Project Settings → API.
#
# Zkopírujte tento soubor jako .env.local a doplňte hodnoty.
# .env.local je v .gitignore a do repozitáře nepatří.
#
# Servisní klíč (service_role) sem NEPATŘÍ. Obchází Row Level Security,
# takže by z něj kdokoli přečetl i změnil data všech firem. Na server
# se dostane jinou cestou, až bude potřeba — do prohlížeče nikdy.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klíč k Resendu — odesílání pozvánek e-mailem.
#
# NENÍ `NEXT_PUBLIC_`, a nesmí být: takové proměnné Next vkládá do
# balíku pro prohlížeč a klíč by si přečetl kdokoli.
#
# Bez něj aplikace běží dál, jen pozvánku nepošle: obrazovka to napíše
# a nabídne odkaz ke zkopírování. Neposlaná pozvánka se nikdy netváří
# jako doručená.
RESEND_API_KEY=

# Adresa, na které aplikace běží — použije se v odkazu v pozvánce.
# Prázdné = vezme se z hlaviček požadavku, což stačí všude kromě
# případu, kdy je před aplikací proxy, která je přepisuje.
NEXT_PUBLIC_APP_URL=

# Šifrovací klíč pro přístupové údaje k poskytovatelům (banka, pokladna,
# účetnictví) v modulu Finance — 64 znaků hexadecimálně (32 bajtů),
# např. `openssl rand -hex 32`. Samostatný od MARKETING_KLIC_SIFRY
# (jiný modul, jiné tajemství — foodtab-marketing: "do cizího modulu
# nesahej"). Bez něj appka klíč k poskytovateli prostě neuloží a řekne
# proč; modul Finance jako celek dál funguje (viz lib/integrace-klice.ts).
INTEGRACE_KLIC_SIFRY=

# Enable Banking (multibank agregátor pro KB/ČSOB/Českou spořitelnu/
# Raiffeisenbank — appka sama není licencovaný AISP u ČNB, jede přes
# tohle). Krok pro Šéfíka, appka si účet nezakládá sama: zdarma,
# samoobslužně na enablebanking.com/sign-in → kontrolní panel → API
# aplikace (sandbox) → soukromý klíč se vygeneruje a stáhne v
# prohlížeči. Bez obou proměnných appka nikdy nezkouší zavolat ven
# (viz lib/integrace-enablebanking.ts, docs/hlaseni/banka-poskytovatele-2026-10-04.md).
# Fio banka klíč NEPOTŘEBUJE proměnnou prostředí — majitel účtu zadává
# svůj token přímo v appce (Finance → Integrace), appka ho šifruje a
# ukládá přes INTEGRACE_KLIC_SIFRY výš, ne přes vlastní proměnnou.
ENABLEBANKING_APPLICATION_ID=
ENABLEBANKING_PRIVATE_KEY=
